APP_ENV=development
HIST_BASE_URL=https://hist.example.com
HIST_API_KEY=
HIST_ALLOW_INSECURE_HTTP=false
HIST_TIMEOUT_SECONDS=60
HIST_MAX_RETRIES=2
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pa

# 每分钟拉取已收盘 1m K 线；近端窗口持续回补缺口；1h 落库，其他周期按需聚合。
COLLECTOR_ENABLED=true
COLLECTOR_SYMBOLS=ES,NQ
COLLECTOR_LOOKBACK_MINUTES=30
COLLECTOR_MAX_CATCHUP_MINUTES=360

# 实时成交更新当前 1m K 线；历史采集器仍负责已收盘数据校准。
LIVE_WS_ENABLED=false
LIVE_WS_URL=wss://dbws.massiveprivateserver.site/live
LIVE_WS_SYMBOLS=ES.c.0,NQ.c.0

# 生产环境建议开启。首次启动会在 users 为空时创建管理员。
AUTH_REQUIRED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_HOURS=24
EXPENSIVE_RATE_LIMIT=20

# Langfuse 可观测性追踪。留空则自动禁用，不影响业务。
# 本地部署请改为你的 Langfuse 实例地址和密钥。
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 追问历史压缩（每轮为一条用户消息和一条助手回复）
FOLLOWUP_COMPACT_AFTER_TURNS=10
FOLLOWUP_KEEP_RECENT_TURNS=4
